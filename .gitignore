# arquivos do macOS
.DS_Store

# pasta de configs do VS Code
.vscode/

# variáveis de ambiente — nunca comitar senhas!
.env

# cache Python
__pycache__/
*.pyc

# banco SQLite local (dev) — agora sempre em backend/, mas ignora os dois
# por segurança caso algum CWD antigo recrie na raiz
backend/vanja.db
/vanja.db
*.db-journal

# certificados SSL gerados no build do Docker
*.key
*.crt

# dumps de Postgres do serviço pg_backup
/backups/
